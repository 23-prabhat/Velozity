# Copy these values into .env. Never commit the real file.
# Neon: use the pooled hostname for DATABASE_URL and the direct hostname for DIRECT_URL.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

NODE_ENV="development"
PORT="4000"
FRONTEND_ORIGIN="http://127.0.0.1:5173"
# Comma-separated exact origins allowed to call the API.
FRONTEND_ORIGINS="http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,https://velozity-frontend-iota.vercel.app"
APP_TIMEZONE="Asia/Kolkata"
OVERDUE_CRON="* * * * *"

# Generate long random secrets before using the API (at least 32 characters each).
JWT_ACCESS_SECRET="replace-with-a-random-secret-at-least-32-characters"
JWT_ISSUER="velozity-api"
JWT_AUDIENCE="velozity-web"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="7"
COOKIE_NAME="velozity_refresh"
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"

# Seed-only credentials. Change them in any non-local environment.
SEED_ADMIN_PASSWORD="ChangeMe-Admin-2026!"
SEED_PM_PASSWORD="ChangeMe-PM-2026!"
SEED_DEVELOPER_PASSWORD="ChangeMe-Developer-2026!"
